# 3D Model Store — environment variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` (it is gitignored). Only `.env.example` belongs in git.

# --- Supabase (https://supabase.com/dashboard) ---
# Project URL and anon (public) key: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (secret — server only, never NEXT_PUBLIC_).
# Used by the checkout API route. Keep it out of the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (https://dashboard.razorpay.com) ---
# Use TEST keys while developing; switch to live keys only at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Razorpay Dashboard → Settings → Webhooks → your webhook.
# The webhook URL is https://your-domain.com/api/webhooks/razorpay
# subscribed to the `payment.captured` event.
RAZORPAY_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
